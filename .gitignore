node_modules/
package-lock.json
build/
dist/

# Actions whose action.yml names runs.main at the action root rather than under
# dist/. The bundle is build output like any other: CI builds it before the
# release tag is cut, so nothing reads a committed copy.
download-release-binary/index.js
ghcr-prune/index.js
tag-runner/index.js

# ts0 compiles each test file beside its source and deletes it after the run. A
# run killed mid-flight leaves one behind.
*.ts0.cjs
*.ts0.mjs
