[private]
help:
	@just --list

# tsc is the only thing that ever reads TypeScript: it type-checks and emits
# JavaScript into .tsc-out (rootDir is the repo root, so sources imported from
# shared/ land beside this action's). esbuild then bundles that JavaScript into
# the single self-contained dist/index.js the release tag ships -- it is a
# bundler here, never a second compiler, so esbuild not type-checking cannot
# hide anything. A type error fails `just build` at the tsc step.
build:
	pnpm install
	ts0 build
