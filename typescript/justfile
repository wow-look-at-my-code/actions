[private]
help:
	@just --list

# Lint the action sources for the "fake string" branded-primitive footgun
# (and the stock boxing guards). Config: eslint.config.js (type-aware).
lint:
	pnpm install
	pnpm exec eslint .

build:
	#!/usr/bin/env bash
	# Builds the action with ts0, then stages the type definitions and
	# TypeScript lib files needed for tsc validation at runtime. Layout:
	#   dist/index.js               (bundled action)
	#   dist/lib.es*.d.ts           (TypeScript standard libs)
	#   dist/types/node_modules/... (mirrored types for module resolution)
	# The orphan release tag ships dist/ verbatim, so stage ONLY what the
	# bundled tsc actually resolves at runtime — no blanket copies.
	set -euo pipefail
	pnpm install
	ts0 build

	dist="dist"
	types_root="$dist/types/node_modules"
	rm -rf "$dist/types"
	find "$dist" -maxdepth 1 -name '*.d.ts' -delete
	mkdir -p "$types_root/@types" "$types_root/@actions"

	# Ambient declarations read at runtime by the action.
	cp globals.d.ts "$dist/"

	# @types/node + undici-types. pnpm keeps transitives under .pnpm/, so
	# undici-types isn't at the top level — fish it out next to @types/node.
	cp -rL node_modules/@types/node "$types_root/@types/"
	undici_src=$(dirname "$(readlink -f node_modules/@types/node)")/../undici-types
	if [ -d "$undici_src" ]; then
		cp -rL "$undici_src" "$types_root/"
	else
		echo "warning: undici-types not found near @types/node" >&2
	fi
	# The ts5.6/ts5.7 fallback trees are selected via typesVersions only for
	# TypeScript <= 5.7; the bundled compiler is pinned newer.
	rm -rf "$types_root/@types/node/ts5.6" "$types_root/@types/node/ts5.7"

	# @actions toolkit types (.d.ts files have no external module imports).
	cp -rL node_modules/@actions/core "$types_root/@actions/"
	cp -rL node_modules/@actions/exec "$types_root/@actions/"
	cp -rL node_modules/@actions/io "$types_root/@actions/"

	# @actions/github whole, plus the @octokit declaration closure its
	# getOctokit signature reaches. This is what types `octokit.rest`: each
	# endpoint takes the arguments that endpoint takes, so a call GitHub has no
	# route for is a compile error rather than a 404 at run time. A hand-rolled
	# stub with `rest: any` in its place accepts any call at all, which is the
	# same as not checking the script.
	#
	# pnpm nests these under the dependent, and tsc resolves an import by
	# walking node_modules up from the importer, so they are flattened into one
	# staged node_modules rather than mirrored tree by tree.
	cp -rL node_modules/@actions/github "$types_root/@actions/"
	rm -rf "$types_root/@actions/github/node_modules"
	mkdir -p "$types_root/@octokit"
	for pkg in core types openapi-types plugin-rest-endpoint-methods plugin-paginate-rest graphql request request-error endpoint auth-token; do
		src=$(find node_modules/.pnpm -maxdepth 4 -type d -path "*/node_modules/@octokit/${pkg}" | head -1)
		if [ -z "$src" ]; then
			echo "::error::@octokit/${pkg} not found under node_modules/.pnpm; octokit calls would go unchecked" >&2
			exit 1
		fi
		cp -rL "$src" "$types_root/@octokit/"
	done

	# Strip everything that isn't a declaration or a license from the staged
	# packages — JS, source maps, READMEs. Only declarations matter to tsc.
	find "$types_root" -type f \( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts.map' -o -name 'README.md' \) -delete

	# TypeScript standard libs: only the `/// <reference lib="..." />` closure
	# of the libs the action can select -- lib.es2022.d.ts always, and
	# lib.dom.d.ts + lib.dom.iterable.d.ts when a step passes dom: true --
	# seeded with any lib the staged type packages reference (@types/node pulls
	# in a couple of esnext.* libs). A blanket copy of typescript/lib would ship every unused
	# lib variant plus the ~600 KB compiler API declarations.
	libdir="node_modules/typescript/lib"
	declare -A staged_libs
	queue="es2022 dom dom.iterable $(grep -rhoP '(?<=<reference lib=")[^"]+' "$types_root" | sort -u || true)"
	while [ -n "${queue//[[:space:]]/}" ]; do
		next=""
		for name in $queue; do
			[ -n "${staged_libs[$name]:-}" ] && continue
			staged_libs[$name]=1
			cp "$libdir/lib.$name.d.ts" "$dist/"
			next+=" $(grep -oP '(?<=<reference lib=")[^"]+' "$libdir/lib.$name.d.ts" || true)"
		done
		queue="$next"
	done
